# Copy to .env and adjust. docker-compose.yml already has working defaults for local dev.

DATABASE_URL=postgresql://subsurface:subsurface@localhost:5432/subsurface
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=1440

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=subsurface
S3_SECRET_KEY=subsurface123
S3_BUCKET=subsurface-data

CORS_ORIGINS=http://localhost:3000

NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional integrations / notifications
APS_CLIENT_ID=
APS_CLIENT_SECRET=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=twin@example.com
# Web Push: generate with `python -m app.push` (in apps/api)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
